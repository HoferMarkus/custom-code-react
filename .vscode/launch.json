{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open Chrome",
      "url": "https://portal.combeenation.com/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Run dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    }
  ],
  "compounds": [
    {
      "name": "Start dev",
      "configurations": ["Open Chrome", "Run dev"],
      "stopAll": true
    }
  ]
}
